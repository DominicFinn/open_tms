<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- The OpenAPI document is written here on every build and committed: it is the contract the
         frontend's generated client is built from, so a change to it shows up in review. -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name finnwms</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FinnWms.Platform\FinnWms.Platform.csproj" />
    <ProjectReference Include="..\FinnWms.Wms\FinnWms.Wms.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\migrations\*.sql" LogicalName="migrations.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
