{
  "openapi": "3.1.1",
  "info": {
    "title": "FinnWMS API",
    "version": "v1"
  },
  "paths": {
    "/api/v1/facilities": {
      "get": {
        "tags": [
          "WMS - Facilities"
        ],
        "summary": "List facilities for the current organisation",
        "operationId": "ListFacilities",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "perPage",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          },
          {
            "name": "includeArchived",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedEnvelopeOfFacilityDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/facilities/{id}": {
      "get": {
        "tags": [
          "WMS - Facilities"
        ],
        "summary": "Get a facility",
        "operationId": "GetFacility",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvelopeOfFacilityDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnvelopeOfFacilityDto": {
        "required": [
          "data",
          "error"
        ],
        "type": "object",
        "properties": {
          "data": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/FacilityDto"
              }
            ]
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ErrorEnvelope": {
        "required": [
          "data",
          "error"
        ],
        "type": "object",
        "properties": {
          "data": { },
          "error": {
            "type": "string"
          }
        }
      },
      "FacilityAddressDto": {
        "required": [
          "address1",
          "address2",
          "city",
          "state",
          "postalCode",
          "country"
        ],
        "type": "object",
        "properties": {
          "address1": {
            "type": [
              "null",
              "string"
            ]
          },
          "address2": {
            "type": [
              "null",
              "string"
            ]
          },
          "city": {
            "type": [
              "null",
              "string"
            ]
          },
          "state": {
            "type": [
              "null",
              "string"
            ]
          },
          "postalCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "country": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "FacilityDto": {
        "required": [
          "id",
          "name",
          "code",
          "sourceLocationId",
          "address",
          "timezone",
          "active",
          "archived"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": [
              "null",
              "string"
            ]
          },
          "sourceLocationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "address": {
            "$ref": "#/components/schemas/FacilityAddressDto"
          },
          "timezone": {
            "type": [
              "null",
              "string"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "archived": {
            "type": "boolean"
          }
        }
      },
      "PageMeta": {
        "required": [
          "page",
          "perPage",
          "total"
        ],
        "type": "object",
        "properties": {
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "perPage": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PagedEnvelopeOfFacilityDto": {
        "required": [
          "data",
          "meta",
          "error"
        ],
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FacilityDto"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "WMS - Facilities"
    }
  ]
}