// FinnTMS: shipments, orders, carriers, lanes, tendering, EDI, tracking, cold chain.
// Module: tms. See .claude/rules/module-boundaries.md for what may depend on what.

model Shipment {
  id                  String        @id @default(uuid())
  // Multi-tenancy: every Shipment is scoped to a single Organization.
  // Tightened to NOT NULL after Phase 2 backfill verification.
  orgId               String
  reference           String
  // Canonical lifecycle: draft -> ready -> in_progress -> complete.
  // Manual transitions are gated (see TransitionShipmentStatusCommand);
  // automatic tracking handlers map carrier milestones onto these values.
  status              String        @default("draft")
  // Orthogonal exception flag — set when a carrier/tracking exception fires,
  // so the lifecycle status is never clobbered by an operational problem.
  hasException        Boolean       @default(false)
  pickupDate          DateTime?
  deliveryDate        DateTime?
  pickupWindowStart   DateTime?
  pickupWindowEnd     DateTime?
  deliveryWindowStart DateTime?
  deliveryWindowEnd   DateTime?
  shipmentType        ShipmentType? @relation(fields: [shipmentTypeId], references: [id])
  shipmentTypeId      String?
  proNumber           String?
  // Transport mode — "FTL" (Full Truck Load) or "LTL" (Less Than Truck Load).
  // Distinct from shipmentType, which drives physical restrictions (temp,
  // hazmat, humidity, equipment), not mode/service level.
  serviceLevel        String?
  items               Json?
  archived            Boolean       @default(false)
  archivedAt          DateTime?
  // Captured on archive (alongside status -> 'archived') so unarchive can
  // restore the prior lifecycle status. Mirrors Order.statusBeforeArchive.
  statusBeforeArchive String?
  // Soft delete (admin-only, distinct from archive): the row is retained for
  // audit but hidden from every view, including the future archived screen.
  deletedAt           DateTime?
  deletedBy           String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  customer            Customer      @relation(fields: [customerId], references: [id])
  customerId          String
  // Nullable so a draft can be saved with a partial/absent route. Route
  // completeness (a lane OR origin+destination) is enforced only when the
  // shipment leaves draft, via the readiness gate.
  origin              Location?     @relation("Origin", fields: [originId], references: [id])
  originId            String?
  destination         Location?     @relation("Destination", fields: [destinationId], references: [id])
  destinationId       String?

  // Cutoff-at-risk monitoring: dedupes notifications, only re-fires on severity escalation
  lastCutoffRiskSeverity String?
  lastCutoffRiskAt       DateTime?
  lastCutoffRiskIssueId  String?
  // ETA-delay monitoring: last delay severity seen, so the monitor can detect the
  // delay -> on-time edge and emit tracking.eta_recovered (drives auto-resolve).
  lastEtaDelaySeverity   String?
  lane                   Lane?              @relation(fields: [laneId], references: [id])
  laneId                 String?
  carrier                Carrier?           @relation(fields: [carrierId], references: [id])
  carrierId              String? // Manual carrier assignment for non-lane shipments
  loads                  Load[]
  events                 ShipmentEvent[]
  orderShipments         OrderShipment[]
  stops                  ShipmentStop[] // Multi-stop route support
  tenders                Tender[] // Carrier tenders for this shipment
  deviceAssignments      DeviceAssignment[] // IoT device assignments
  sensorReadings         SensorReading[] // Sensor telemetry data

  // Cargo tracking
  cargoScans         CargoScan[]
  cargoDiscrepancies CargoDiscrepancy[]

  // Read model relations
  orderReadModels OrderReadModel[]

  // Cold chain
  effectiveMinTemp      Float? // Computed from orders (°C canonical)
  effectiveMaxTemp      Float?
  effectiveAlertMinTemp Float? // Warning thresholds (tighter than min/max)
  effectiveAlertMaxTemp Float?
  coldChainDisposition  String                    @default("not_applicable") // not_applicable, monitoring, pending_review, released, quarantined
  dispositionSetBy      String?
  dispositionSetAt      DateTime?
  dispositionNotes      String?
  temperatureLogs       ImmutableTemperatureLog[]
  coldChainExcursions   ColdChainExcursion[]
  capaReports           CAPAReport[]

  // Declared restrictions (set at shipment creation, distinct from the
  // effective* fields above which are computed from linked orders)
  tempControlled        Boolean @default(false)
  tempMinC              Float?
  tempMaxC              Float?
  humidityControlled    Boolean @default(false)
  humidityMinPct        Float?
  humidityMaxPct        Float?
  hazmat                Boolean @default(false)
  unNumber              String? // e.g. "UN1203"
  hazmatClass           String? // e.g. "3" (flammable liquid)
  packingGroup          String? // I | II | III
  properShippingName    String?
  requiredEquipmentType String? // dryVan, reefer, flatbed, tanker, intermodal

  // Custom fields
  customFieldVersionId String?
  customFieldValues    Json?

  // Financial
  charges                  Charge[]
  shipmentFinancialSummary ShipmentFinancialSummary?

  // Warehouse app
  accessories ShipmentAccessory[] // Door seals, BLE sensors, etc.
  flags       ShipmentFlag[] // Warehouse user flagged issues
  launchedAt  DateTime? // When warehouse user completed launch workflow
  launchedBy  String? // User ID who launched

  // Carrier tracking API
  trackingNumber        String? // Carrier tracking number (PRO, AWB, etc.)
  carrierTrackingEvents CarrierTrackingEvent[]

  // Brokerage
  commissions Commission[]

  @@index([customerId])
  @@index([status])
  @@index([originId])
  @@index([destinationId])
  @@index([carrierId])
  @@index([laneId])
  @@index([archived])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([reference])
  @@index([trackingNumber])
  @@index([status, archived])
  @@index([customerId, status])
  @@index([originId, archived, status])
  @@index([destinationId, archived, status])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, archived, status])
}

model ShipmentStop {
  id         String   @id @default(uuid())
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId String
  location   Location @relation(fields: [locationId], references: [id])
  locationId String

  // Stop sequence in the route (1 = first stop, 2 = second, etc.)
  sequenceNumber Int

  // Type of stop
  stopType String @default("delivery") // pickup, delivery, both

  // Timing
  estimatedArrival   DateTime?
  actualArrival      DateTime?
  estimatedDeparture DateTime?
  actualDeparture    DateTime?

  // Status
  status String @default("pending") // pending, arrived, in_progress, completed, skipped

  // Orders to be delivered at this stop
  orders Order[]

  // Geofencing (for automatic status updates)
  geofenceRadius  Float? // Radius in meters for geofence trigger
  geofenceEnabled Boolean @default(false)

  // Notes and instructions
  notes        String?
  instructions String? // Specific delivery instructions for this stop

  // Proof of delivery
  signatureUrl    String? // URL to signature image
  photoUrls       Json? // Array of photo URLs
  proofOfDelivery Json? // Additional proof data

  // Cargo tracking relations
  cargoScans            CargoScan[]
  discrepanciesExpected CargoDiscrepancy[] @relation("ExpectedStop")
  discrepanciesActual   CargoDiscrepancy[] @relation("ActualStop")
  trackableUnitsHere    TrackableUnit[]    @relation("UnitCurrentStop")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shipmentId, sequenceNumber])
  @@index([shipmentId])
  @@index([locationId])
  @@index([status])
}

// ─── Arrival Criteria ─────────────────────────────────────────────────────────
// Every location should have at least one arrival criteria to determine
// when a shipment has arrived. Types: geofence, wifi, ble (Bluetooth anchor).

model ArrivalCriteria {
  id         String   @id @default(uuid())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String

  // Criteria type
  criteriaType String // "geofence", "wifi", "ble"

  // Geofence criteria
  radiusMeters Float? // Radius in meters for geofence trigger
  lat          Float? // Center latitude (defaults to location lat if null)
  lng          Float? // Center longitude (defaults to location lng if null)

  // WiFi criteria (IoT device detects a known WiFi network)
  wifiSsid  String? // WiFi network name (SSID)
  wifiBssid String? // WiFi access point MAC address (BSSID) for precise identification

  // BLE criteria (Bluetooth Low Energy location anchor / reader)
  bleUuid           String? // BLE beacon UUID
  bleMajor          Int? // BLE beacon major value
  bleMinor          Int? // BLE beacon minor value
  bleRssiThreshold  Int? // RSSI threshold for proximity detection (e.g., -70 dBm)
  bleAnchorId       String? // Fixed anchor/reader ID at this location (matches device reports)
  bleReaderLocation String? // Where the reader is at this location (e.g., "Loading Dock B")

  // Metadata
  name     String? // Optional friendly name (e.g., "Loading Dock A WiFi")
  active   Boolean @default(true)
  priority Int     @default(0) // Higher priority criteria checked first

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locationId])
  @@index([criteriaType])
  @@index([locationId, active])
}

model ShipmentEvent {
  id              String   @id @default(uuid())
  shipment        Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId      String
  eventType       String // Canonical timeline type (see shared/shipmentEventTypes.ts) or legacy device/edi type
  description     String? // User-facing summary of what happened
  source          String? // Provenance: system | device | edi
  sourceEventId   String? // Originating DomainEventLog id — idempotency key for the timeline projection
  deviceId        String? // External device ID (e.g., "72308628872889491")
  deviceName      String? // Device display name (e.g., "SH-0001")
  lat             Float? // Latitude from GPS
  lng             Float? // Longitude from GPS
  address         String? // Human-readable address
  locationSummary String? // Full location summary from webhook
  rawPayload      Json? // Store the entire webhook payload for debugging
  eventTime       DateTime // When the event occurred (from webhook)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([shipmentId])
  @@index([eventTime])
  @@index([eventType])
  @@index([sourceEventId])
}

// Carrier cutoff times: latest handoff time for same-day pickup or a service-level guarantee.
// The monitor compares projected warehouse-ready-time against these rows to fire shipment.cutoff_at_risk.
model CarrierCutoff {
  id              String   @id @default(uuid())
  carrierId       String
  carrier         Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  locationId      String? // optional per-location override
  dayOfWeek       Int // 0 = Sunday, 6 = Saturday
  cutoffLocalTime String // "HH:mm" 24-hour
  timezone        String   @default("UTC") // IANA tz name, e.g. "America/New_York"
  serviceLevel    String? // e.g. "ground", "2day", null = all services
  notes           String?
  active          Boolean  @default(true)
  orgId           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([carrierId, dayOfWeek])
  @@index([orgId])
  @@index([active])
}

model Carrier {
  id           String          @id @default(uuid())
  // Multi-tenancy: every Carrier is scoped to a single Organization.
  // Tightened to NOT NULL in Phase 2 of the multi-tenancy plan.
  orgId        String
  name         String
  mcNumber     String?
  dotNumber    String?
  contactName  String?
  contactEmail String?
  contactPhone String?
  address1     String?
  address2     String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  // Optional PRO number format hint for this carrier — used to auto-fill
  // and soft-validate the PRO number field when this carrier is assigned
  // to a shipment. Not enforced server-side: a stale/wrong hint must never
  // block a real PRO number from being saved.
  proNumberPrefix    String?
  proNumberMaxLength Int?
  archived     Boolean         @default(false)
  archivedAt   DateTime?
  // Soft delete (tombstone). Deleted carriers 404 everywhere but are retained
  // for audit/finance history. Only allowed when not assigned to any lane.
  deletedAt    DateTime?
  deletedBy    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  vehicles     Vehicle[]
  drivers      Driver[]
  laneCarriers LaneCarrier[]
  shipments    Shipment[]
  cutoffs      CarrierCutoff[]

  // Carrier Validation (SOP-CL-001)
  validationTier       String? // "tier1" | "tier2" | "tier3" | null
  registrationChecked  Boolean   @default(false)
  insuranceDocReceived Boolean   @default(false)
  insuranceVerified    Boolean   @default(false)
  identityConfirmed    Boolean   @default(false)
  complianceChecked    Boolean   @default(false)
  validationNotes      String?
  validatedAt          DateTime?
  validatedBy          String?

  // Standard Carrier Alpha Code (needed for EDI 204)
  scacCode String?

  // Return label generation (carrier API or manual)
  returnLabelProvider       String? // null = not configured; manual | fedex | ups | dhl
  returnLabelAccountNumber  String? // carrier-side account number for return labels
  returnLabelDefaultService String? // default service level (ground, 2day, etc.)

  // Payment & Remittance
  paymentTermsDays  Int     @default(30)
  remitToName       String?
  remitToAddress1   String?
  remitToCity       String?
  remitToState      String?
  remitToPostalCode String?
  remitToCountry    String?
  currency          String  @default("USD")

  // Custom fields
  customFieldVersionId String?
  customFieldValues    Json?

  // Tendering relations
  carrierUsers    CarrierUser[]
  tenderOffers    TenderOffer[]
  tenderBids      TenderBid[]
  tradingPartners TradingPartner[] @relation("CarrierTradingPartners")

  // Financial relations
  carrierInvoices CarrierInvoice[]
  creditNotes     CreditNote[]     @relation("CarrierCreditNotes")

  // Read model relations
  shipmentReadModels ShipmentReadModel[]

  // Carrier tracking API integration
  trackingIntegration CarrierTrackingIntegration?
  trackingEvents      CarrierTrackingEvent[]

  @@index([orgId])
}

model Vehicle {
  id         String   @id @default(uuid())
  // Multi-tenancy: every Vehicle is scoped to a single Organization
  // (always matches its Carrier's orgId).
  orgId      String
  carrier    Carrier  @relation(fields: [carrierId], references: [id])
  carrierId  String
  plate      String
  type       String
  capacityKg Int?
  capacityM3 Int?
  loads      Load[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([carrierId])
  @@index([orgId])
}

model Driver {
  id        String   @id @default(uuid())
  // Multi-tenancy: every Driver is scoped to a single Organization
  // (always matches their Carrier's orgId).
  orgId     String
  carrier   Carrier  @relation(fields: [carrierId], references: [id])
  carrierId String
  name      String
  phone     String?
  email     String?
  loads     Load[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carrierId])
  @@index([orgId])
}

model Load {
  id         String    @id @default(uuid())
  shipment   Shipment  @relation(fields: [shipmentId], references: [id])
  shipmentId String
  vehicle    Vehicle?  @relation(fields: [vehicleId], references: [id])
  vehicleId  String?
  driver     Driver?   @relation(fields: [driverId], references: [id])
  driverId   String?
  assignedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([shipmentId])
  @@index([vehicleId])
  @@index([driverId])
}

model Lane {
  id            String   @id @default(uuid())
  // Multi-tenancy: every Lane is scoped to a single Organization.
  orgId         String
  name          String // Auto-generated: "Origin → Destination"
  origin        Location @relation("LaneOrigin", fields: [originId], references: [id])
  originId      String
  destination   Location @relation("LaneDestination", fields: [destinationId], references: [id])
  destinationId String
  distance      Float? // Optional distance in km
  notes         String?

  // Lane capabilities for order matching
  serviceLevel               String  @default("LTL") // "FTL", "LTL", or "Both"
  supportsTemperatureControl Boolean @default(false) // Can handle refrigerated/frozen
  supportsHazmat             Boolean @default(false) // Hazmat certified
  maxWeight                  Float? // Maximum weight capacity in kg
  maxVolume                  Float? // Maximum volume capacity in m³

  status        String         @default("active") // active/archived
  archived      Boolean        @default(false)
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  shipments     Shipment[]
  customerLanes CustomerLane[]
  laneCarriers  LaneCarrier[]
  stops         LaneStop[]
  route         LaneRoute?

  // Read model relations
  shipmentReadModels ShipmentReadModel[]

  @@index([orgId])
}

model CustomerLane {
  id         String   @id @default(uuid())
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  lane       Lane     @relation(fields: [laneId], references: [id])
  laneId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, laneId])
  @@index([customerId])
  @@index([laneId])
}

model LaneCarrier {
  id           String   @id @default(uuid())
  lane         Lane     @relation(fields: [laneId], references: [id])
  laneId       String
  carrier      Carrier  @relation(fields: [carrierId], references: [id])
  carrierId    String
  price        Float? // Price per shipment or per km (deprecated — use priceCents)
  priceCents   Int? // Price in cents — canonical field for financial calculations
  currency     String   @default("USD")
  serviceLevel String? // e.g., "Standard", "Express", "Economy"
  notes        String?
  assigned     Boolean  @default(false) // True if this carrier is assigned to the lane
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Contract rate fields
  rateType             String? // "per_mile" | "flat" | "cwt"
  contractStartDate    DateTime?
  contractEndDate      DateTime?
  fuelSurchargePercent Float?
  accessorialRates     Json? // { "detention": 50, "lumper": 75, ... }
  isContractRate       Boolean   @default(false)

  // Broker: Target margin for this lane-carrier combo
  targetMarginPercent Decimal? @db.Decimal(5, 2)

  @@unique([laneId, carrierId])
  @@index([laneId])
  @@index([carrierId])
}

model LaneStop {
  id         String   @id @default(uuid())
  lane       Lane     @relation(fields: [laneId], references: [id], onDelete: Cascade)
  laneId     String
  location   Location @relation(fields: [locationId], references: [id])
  locationId String
  order      Int // Order of the stop in the lane (1, 2, 3, etc.)
  notes      String? // Optional notes for this specific stop
  // What this stop is for — informational only, doesn't affect routing/rating.
  // pickup | dropoff | cross_dock | fuel | rest | hub | customs | other
  purpose    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([laneId, order])
  @@unique([laneId, locationId])
  @@index([laneId])
  @@index([locationId])
}

model Order {
  id           String  @id @default(uuid())
  // Multi-tenancy: every Order is scoped to a single Organization.
  // Tightened to NOT NULL in Phase 2 of the multi-tenancy plan.
  orgId        String
  orderNumber  String  @unique // Customer's order number or our generated number
  poNumber     String? // Purchase order number
  status       String  @default("pending") // pending, verified, assigned, issue, cancelled, archived
  importSource String  @default("manual") // manual, csv, edi
  ediData      Json? // Store original EDI data if imported via EDI

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  // Origin and destination - nullable because location might not exist yet
  origin          Location? @relation("OrderOrigin", fields: [originId], references: [id])
  originId        String?
  originData      Json? // Store raw location data if location doesn't exist
  originValidated Boolean   @default(false)

  destination          Location? @relation("OrderDestination", fields: [destinationId], references: [id])
  destinationId        String?
  destinationData      Json? // Store raw location data if location doesn't exist
  destinationValidated Boolean   @default(false)

  // Dates
  orderDate             DateTime  @default(now())
  requestedPickupDate   DateTime?
  requestedDeliveryDate DateTime?

  // Special requirements for shipment assignment
  serviceLevel        String  @default("LTL") // "FTL" (Full Truck Load) or "LTL" (Less Than Truck Load)
  temperatureControl  String  @default("ambient") // "ambient", "refrigerated", "frozen"
  requiresHazmat      Boolean @default(false)
  specialRequirements Json? // Additional requirements as JSON array

  // Delivery status tracking (separate from order lifecycle status). Null
  // until the order is actually moving — 'assigned' is redundant with
  // status='assigned' and is no longer a valid value here.
  deliveryStatus      String? // in_transit, delivered, exception (null = not moving yet)
  deliveredAt         DateTime? // When the order was delivered
  deliveryConfirmedBy String? // User ID or system identifier who confirmed delivery
  deliveryMethod      String? // manual, geofence, geofence_iot, auto, driver_app
  deliveryNotes       String? // Notes about the delivery
  exceptionType       String? // If exception status: delay, damage, refused, address_issue, weather, other
  exceptionNotes      String? // Details about the exception
  exceptionResolvedAt DateTime? // When the exception was resolved

  // Link to the specific stop where this order should be delivered (for multi-stop shipments)
  deliveryStop   ShipmentStop? @relation(fields: [deliveryStopId], references: [id])
  deliveryStopId String?

  // Trackable units (pallets, totes, boxes, etc.)
  trackableUnits TrackableUnit[]

  // Line items (legacy - will be moved to trackable units)
  lineItems OrderLineItem[]

  // Additional info
  specialInstructions String?
  notes               String?

  // Tracking
  archived            Boolean   @default(false)
  archivedAt          DateTime?
  statusBeforeArchive String? // Captured on archive so unarchive can restore the prior lifecycle status
  deletedAt           DateTime? // Soft delete - set when order is deleted
  deletedBy           String? // User ID who deleted the order
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relationship to shipments
  orderShipments OrderShipment[]

  // Audit trail
  auditLogs AuditLog[]

  // Pending lane requests
  pendingLaneRequests PendingLaneRequest[]

  // IoT device tracking
  deviceAssignments DeviceAssignment[]
  sensorReadings    SensorReading[]

  // Financial
  charges Charge[]

  // Custom fields
  customFieldVersionId String?
  customFieldValues    Json?

  @@index([customerId])
  @@index([status])
  @@index([archived])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([deliveryStatus])
  @@index([originId])
  @@index([destinationId])
  @@index([status, archived])
  @@index([customerId, archived])
  @@index([orgId])
  @@index([orgId, status])
}

model OrderLineItem {
  id      String @id @default(uuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  // Optional: which trackable unit does this item belong to?
  trackableUnit   TrackableUnit? @relation(fields: [trackableUnitId], references: [id], onDelete: Cascade)
  trackableUnitId String?

  sku         String
  description String?
  quantity    Int
  weight      Float? // in kg
  weightUnit  String  @default("kg")
  length      Float? // dimensions in cm
  width       Float?
  height      Float?
  dimUnit     String  @default("cm")

  // Additional fields
  hazmat      Boolean @default(false)
  temperature String? // e.g., "ambient", "refrigerated", "frozen"

  // Pricing
  unitPriceCents  Int? // Price per unit in cents
  totalPriceCents Int? // quantity * unitPriceCents
  priceCurrency   String @default("USD")

  // LTL classification
  freightClass String? // 50, 55, 60, 65, 70, 77.5, 85, 92.5, 100, 110, 125, 150, 175, 200, 250, 300, 400, 500
  nmfcCode     String? // National Motor Freight Classification code

  // Unit of measure for the line (each | pieces | cases | pallets | cartons | kg | lb)
  unitOfMeasure String @default("each")

  // Hazmat detail — required when hazmat = true
  unNumber           String? // e.g. "UN1203"
  hazmatClass        String? // e.g. "3" (flammable liquid)
  packingGroup       String? // I | II | III
  properShippingName String?

  // Customs (international shipments)
  hsCode          String? // Harmonized System code
  countryOfOrigin String? // ISO 3166-1 alpha-2

  // Temperature range (keep `temperature` label for display)
  tempMinC Float?
  tempMaxC Float?

  // WMS relations
  allocations Allocation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([sku])
}

model OrderShipment {
  id         String   @id @default(uuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  shipmentId String
  createdAt  DateTime @default(now())

  @@unique([orderId, shipmentId])
  @@index([orderId])
  @@index([shipmentId])
}

model TrackableUnit {
  id      String @id @default(uuid())
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  // Unit identification
  identifier     String // e.g., "PALLET-001", "BOX-123", user-defined identifier
  unitType       String // Snapshot of the org setting at creation time (pallet, tote, box, stillage, custom)
  customTypeName String? // If custom type was used

  // Sequence number within the order
  sequenceNumber Int // 1, 2, 3... for ordering within an order

  // Line items contained in this unit
  lineItems OrderLineItem[]

  // Additional tracking
  barcode String? // Optional barcode/QR code
  notes   String?

  // Phase 2: per-unit dim/weight overrides for sophisticated shippers (mixed-SKU
  // pallets, custom-built handling units). When null, cartonization falls back
  // to summing the contained line items.
  weight     Float? // total weight of this unit (cargo + tare)
  weightUnit String  @default("kg")
  length     Float? // external footprint of this unit
  width      Float?
  height     Float?
  dimUnit    String  @default("cm")
  stackable  Boolean @default(true)

  // IoT device tracking at unit level
  sensorReadings SensorReading[]
  deviceEvents   DeviceEvent[]

  // Cargo tracking — where this unit physically is right now
  currentStopId String? // Which stop this unit is currently at (null = in transit / on vehicle)
  currentStop   ShipmentStop? @relation("UnitCurrentStop", fields: [currentStopId], references: [id])
  condition     String        @default("good") // good, damaged, lost, unknown
  lastScannedAt DateTime?

  // Cargo scan & discrepancy relations
  cargoScans    CargoScan[]
  discrepancies CargoDiscrepancy[]

  // Packaging specification (any kind from the PackagingType catalogue); null = ad-hoc / unspecified
  packagingTypeId String?
  packagingType   PackagingType? @relation(fields: [packagingTypeId], references: [id])

  // WMS fields
  currentBinId    String?
  currentBin      WarehouseBin?   @relation("UnitCurrentBin", fields: [currentBinId], references: [id])
  parentUnitId    String?
  parentUnit      TrackableUnit?  @relation("UnitNesting", fields: [parentUnitId], references: [id])
  childUnits      TrackableUnit[] @relation("UnitNesting")
  currentZoneId   String?
  currentZone     WarehouseZone?  @relation("UnitCurrentZone", fields: [currentZoneId], references: [id])
  lotNumber       String?
  expiryDate      DateTime?
  receivedAt      DateTime?
  ownerCustomerId String?
  ownerCustomer   Customer?       @relation("OwnedUnits", fields: [ownerCustomerId], references: [id])
  qualityStatus   String          @default("available") // available, hold, quarantine, damaged

  // WMS task relations
  putawayTasks          PutawayTask[]
  receivingLines        ReceivingLine[]
  pickLines             PickLine[]
  packLines             PackLine[]
  allocations           Allocation[]
  inventoryTransactions InventoryTransaction[]
  stagingAssignments    StagingAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, sequenceNumber])
  @@index([orderId])
  @@index([currentStopId])
  @@index([currentBinId])
  @@index([currentZoneId])
  @@index([parentUnitId])
  @@index([ownerCustomerId])
  @@index([lotNumber])
}

model PendingLaneRequest {
